.venv/
.env
__pycache__/
*.pyc
mlruns/
mlflow.db
mlflow.db-*

# Model artifacts are large and hash-verifiable from MANIFEST.json — do not commit weights
models/*/
!models/MANIFEST.json

# Benchmark outputs regenerate from the harness; keep the repo light.
# ** (not *) so this actually reaches nested dirs like results/sweep/ —
# a bare `results/*.jsonl` only matches the top level and silently let 135
# real sweep result files into a commit before this was caught.
results/**/*.jsonl
results/*.jsonl
results/**/*.csv
results/*.csv
results/figures/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Type/lint/test caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

uv.lock.bak
