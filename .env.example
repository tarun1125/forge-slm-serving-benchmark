# Copy to .env and fill in values. Never commit .env — it is gitignored.

# --- Logging ---
LOG_LEVEL=INFO

# --- Experiment tracking ---
# sqlite, not a plain "./mlruns" folder: mlflow's filesystem backend is in
# maintenance mode and hard-errors without MLFLOW_ALLOW_FILE_STORE=true on
# the version this repo pins. sqlite is still one local file, no server.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Hosted API arms (Phase 2, arm 5) ---
GROQ_API_KEY=
NIM_API_KEY=

# --- Execution-accuracy scoring (parity check + Phase 2 accuracy sweeps) ---
# No MONGODB_URI here by design: FORGE imports the capstone's own atlas_env.connect(),
# which auto-discovers capstone-project/CSAIML-Capstone-Project-20/atlas-credentials.env
# by walking up from its own file. Duplicating the URI into this .env would mean two
# copies of the same secret — see docs/parity-check-design.md.

# --- Cross-repo reuse ---
# Absolute path to the capstone repo. FORGE imports its execute_queries.py
# scoring/safety logic and its rag_test.json / split_manifest.json data
# rather than re-deriving them — see docs/parity-check-design.md.
CAPSTONE_REPO_PATH=/absolute/path/to/CSAIML-Capstone-Project-20

# --- Model identity (Phase 1) ---
BASE_MODEL=mlx-community/Qwen2.5-Coder-1.5B-Instruct-bf16
ADAPTER_PATH=/absolute/path/to/CSAIML-Capstone-Project-20/fine_tuning/adapters_23db_1000iter

# --- Phase 4: HF Hub model upload + Space deploy ---
# Token needs write access — create one at https://huggingface.co/settings/tokens
# with "Write" role. Only used locally by forge.phase4.upload_model; the GitHub
# Actions Space-deploy workflow uses its own HF_TOKEN repo secret, not this file.
HF_TOKEN=
HF_USERNAME=

# --- Phase 2, arm 5: vLLM on a rented CUDA GPU (docs/cloud-arm.md) ---
# Where the remote server is reachable from THIS machine. The documented
# setup forwards it over SSH rather than exposing port 8000 publicly:
#   ssh -N -L 8001:127.0.0.1:8000 <user>@<vm-ip>
VLLM_CUDA_BASE_URL=
# Whatever you passed to `vllm serve --served-model-name`.
VLLM_CUDA_MODEL_ID=forge-bf16
VLLM_CUDA_API_KEY=
# Provenance for the machine that actually serves. The sweep runs here, so
# every row's `hardware` field says "Apple M5 Pro" whether or not an A100 did
# the work — these fields are the only thing that distinguishes a cloud row
# from a local one in the saved data. GPU_NAME is required and the arm refuses
# to build without it:
#   nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
VLLM_CUDA_GPU_NAME=
VLLM_CUDA_PROVIDER=
VLLM_CUDA_INSTANCE_TYPE=
VLLM_CUDA_REGION=
VLLM_CUDA_GPU_MEMORY_GB=
# The independent variable in Phase 3's cloud scaling factor — record the
# vendor spec (T4 320, L4 300, A10G 600, A100 80GB 2039).
VLLM_CUDA_GPU_MEMORY_BANDWIDTH_GB_S=
# The rate you actually paid, for build_report's cloud_gpu_hourly_usd.
VLLM_CUDA_HOURLY_USD=

# --- Phase 2, arm 6: Ollama on a rented cloud CPU (docs/cloud-arm.md) ---
# The same daemon, Modelfile and tag as the local `ollama` arm, on commodity
# cloud CPU. Needs no GPU quota and no pay-as-you-go upgrade, which is why it
# is the arm to run first. Tunnel it the same way:
#   ssh -N -L 11435:127.0.0.1:11434 <user>@<vm-ip>
OLLAMA_CLOUD_BASE_URL=
# Defaults to the local arm's registered tag (forge-qwen-coder-ft:q4). Leave
# blank if you registered the GGUF on the VM with this repo's own Modelfile —
# the point of this arm is that both ends ask for the identical model.
OLLAMA_CLOUD_MODEL_ID=
# Required, same as the GPU arm: without it the rows cannot say what ran them.
#   lscpu | grep 'Model name'
OLLAMA_CLOUD_CPU_NAME=
OLLAMA_CLOUD_PROVIDER=
OLLAMA_CLOUD_INSTANCE_TYPE=
OLLAMA_CLOUD_REGION=
OLLAMA_CLOUD_MEMORY_GB=
# Leave blank unless the vendor publishes a per-instance figure — a guessed
# bandwidth is worse than none in the one field Phase 3's scaling factor reads.
OLLAMA_CLOUD_MEMORY_BANDWIDTH_GB_S=
OLLAMA_CLOUD_HOURLY_USD=
