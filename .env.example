# Copy to .env and fill in values. Never commit .env — it is gitignored.

# --- Logging ---
LOG_LEVEL=INFO

# --- Experiment tracking ---
MLFLOW_TRACKING_URI=./mlruns

# --- Hosted API arms (Phase 2, arm 5) ---
GROQ_API_KEY=
NIM_API_KEY=

# --- Execution-accuracy scoring (parity check + Phase 2 accuracy sweeps) ---
# No MONGODB_URI here by design: FORGE imports the capstone's own atlas_env.connect(),
# which auto-discovers capstone-project/CSAIML-Capstone-Project-20/atlas-credentials.env
# by walking up from its own file. Duplicating the URI into this .env would mean two
# copies of the same secret — see docs/parity-check-design.md.

# --- Cross-repo reuse ---
# Absolute path to the capstone repo. FORGE imports its execute_queries.py
# scoring/safety logic and its rag_test.json / split_manifest.json data
# rather than re-deriving them — see docs/parity-check-design.md.
CAPSTONE_REPO_PATH=/Users/tarungudapati/Documents/ai-projects/capstone-project/CSAIML-Capstone-Project-20

# --- Model identity (Phase 1) ---
BASE_MODEL=mlx-community/Qwen2.5-Coder-1.5B-Instruct-bf16
ADAPTER_PATH=/Users/tarungudapati/Documents/ai-projects/capstone-project/CSAIML-Capstone-Project-20/fine_tuning/adapters_23db_1000iter
